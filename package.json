{
  "name": "brxel-website",
  "version": "1.0.0",
  "private": true,
  "description": "BRXEL — graphic design studio: brand identity, social media, print and UI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
