# ── Database (required) ──────────────────────────────────────────────
# Hostinger: hPanel → Databases → MySQL Databases. Use the host, database,
# user and password shown there. Special characters in the password must be
# URL-encoded (@ → %40, # → %23, / → %2F).
DATABASE_URL=mysql://u123456789_brxel:YOUR-PASSWORD@localhost:3306/u123456789_brxel
# Connections kept open per app instance (default 10).
DATABASE_POOL_SIZE=10

# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://brxel.co
# Where the enquiry form posts JSON. Leave empty to hand enquiries to WhatsApp/email.
NEXT_PUBLIC_FORM_ENDPOINT=

# ── Uploads ──────────────────────────────────────────────────────────
# Absolute path OUTSIDE the app folder, so redeploys never delete uploads.
# Hostinger example: /home/u123456789/brxel-uploads
UPLOAD_DIR=./storage/uploads

# ── First owner account (first start only) ───────────────────────────
# On the first start, if there are no users yet, an owner is created from
# these. Remove ADMIN_PASSWORD once you have signed in.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
